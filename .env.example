# Browser-safe Supabase values from Project Settings > API.
# The anon / publishable key may be used with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Local: http://localhost:3000  |  Production: https://dashboard.weatherproinsulation.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER prefix this with NEXT_PUBLIC_.
# Never expose the service role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
